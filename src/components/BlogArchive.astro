---
import type { CollectionEntry } from 'astro:content';
import IslandButton from './IslandButton.astro';
import TagNav from './TagNav.astro';
import { categories, dateLabel } from '../lib/blog';
import { tagHref, tagIndex } from '../lib/tags';
interface Props { posts: CollectionEntry<'posts'>[]; allPosts: CollectionEntry<'posts'>[]; activeTag?: string; }
const { posts, allPosts, activeTag } = Astro.props;
---
<section class="blog-archive" aria-labelledby="archive-title">
  <div class="archive-head"><h2 id="archive-title">{activeTag ? `${activeTag}手记` : '手记'}</h2><p>{posts.length} 篇记录</p></div>
  <TagNav section="blog" tags={tagIndex(allPosts)} active={activeTag} />
  <div class="blog-tools" hidden id="blogTools"><label class="blog-search"><span class="visually-hidden">搜索当前分类的标题、摘要或标签</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg><input type="search" id="blogSearch" placeholder="找一篇手记…" autocomplete="off" /></label></div>
  <p class="visually-hidden" id="filterStatus" role="status" aria-live="polite"></p>
  <ol class="post-list">
    {posts.map((post, index) => <li class:list={['post-entry', { 'post-entry-first': index === 0 }]} data-post data-category={post.data.category} data-search={`${post.data.title} ${post.data.excerpt} ${post.data.tags.join(' ')}`.toLocaleLowerCase()}>
      <div class="post-date"><time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>{dateLabel(post.data.publishedAt)}</time><a class="category-link" href={tagHref('blog', categories[post.data.category])}>{categories[post.data.category]}</a></div>
      <div class="post-summary"><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.excerpt}</p><ul class="post-tags" aria-label="文章标签">{post.data.tags.map(tag => <li><a href={tagHref('blog', tag)}>{tag}</a></li>)}</ul></div>
      {post.data.cover ? <img class="post-thumbnail" src={post.data.cover} alt={post.data.coverAlt} loading="lazy" width="240" height="180" /> : <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
    </li>)}
  </ol>
  {posts.length === 0 && <p class="blog-empty">第一篇手记还在酝酿，过阵子再来看看。</p>}
  <div class="blog-empty" id="noResults" hidden><p>没有找到这篇手记，换个词试试。</p><IslandButton className="filter-button" id="clearFilters">清除搜索</IslandButton></div>
</section>
<script>
  const tools = document.getElementById('blogTools');
  const search = document.querySelector<HTMLInputElement>('#blogSearch');
  const posts = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  if (tools) tools.hidden = false;
  const filter = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let count = 0;
    posts.forEach(post => { post.hidden = !(post.dataset.search ?? '').includes(query); if (!post.hidden) count++; });
    const empty = document.getElementById('noResults'); if (empty) empty.hidden = count !== 0;
    const status = document.getElementById('filterStatus'); if (status) status.textContent = `找到 ${count} 篇手记`;
  };
  search?.addEventListener('input', filter);
  document.getElementById('clearFilters')?.addEventListener('click', () => { if (search) search.value = ''; filter(); search?.focus(); });
</script>
